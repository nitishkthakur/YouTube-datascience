{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_script_md.sh",
            "timeout": 10,
            "statusMessage": "Checking script.md guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python tools/lint_scenes.py --hook",
            "timeout": 60,
            "statusMessage": "Linting against AGENTS.md rules"
          }
        ]
      }
    ]
  }
}
